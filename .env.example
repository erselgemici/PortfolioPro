# Bu dosyayı .env adıyla kopyala ve değerleri değiştir. .env dosyası GitHub'a GİTMEZ (.gitignore'da).

# Veritabanı (PostgreSQL) şifresi: uzun ve rastgele olsun
DB_PASSWORD=Degistir_Bunu_123!

# JWT imzalama anahtarı: en az 32 karakter, rastgele olmalı
# Üretmek için (PowerShell): $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_KEY=buraya-en-az-32-karakterlik-rastgele-bir-deger-yaz

# İlk açılışta oluşturulacak admin kullanıcı (sonra panelden şifreyi değiştirebilirsin)
ADMIN_EMAIL=admin@ornek.com
ADMIN_PASSWORD=GucluSifre12345
ADMIN_FULL_NAME=Ersel Gemici

# Sitenin alan adı (https sertifikası bu ada alınır). Bilgisayarında denerken localhost bırak.
DOMAIN=localhost
